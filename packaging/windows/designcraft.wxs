<?xml version="1.0" encoding="utf-8"?>
<!--
  MIXEL Design MSI (WiX Toolset v5: `dotnet tool install -g wix`). Built by package.ps1:

    wix build designcraft.wxs -arch x64 -d Version=1.2.3 -d BinDir=... -d IconPath=... -o out.msi

  Per-machine install into Program Files, a Start Menu shortcut, `.pcraft` owned by MIXEL Design,
  and MIXEL Design offered under "Open with" for PSD/PSB and the image formats it reads (without
  taking over the user's default app for them).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="MIXEL Design"
      Manufacturer="MIXEL"
      Version="$(var.Version)"
      UpgradeCode="7AFB5762-2860-559C-945E-D9635819FFAA"
      Scope="perMachine"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="MIXEL Design page layout and publishing" Manufacturer="MIXEL" />
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of MIXEL Design is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="DesigncraftIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="DesigncraftIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/jangopeopleV2/mixel-design" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/jangopeopleV2/mixel-design" />
    <Property Id="ARPHELPLINK" Value="https://www.mixel.ch" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="MIXEL Design">
        <Directory Id="LegalDira77854315fcafe53db14" Name="Licenses">
          <Directory Id="LegalDir586c79a12a8241f97438" Name="epaint_default_fonts-0.36.2" />
        </Directory>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main" Title="MIXEL Design" Level="1">
      <ComponentGroupRef Id="LegalNoticesDesign" />
      <ComponentGroupRef Id="DesigncraftFiles" />
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="DesigncraftFiles" Directory="INSTALLFOLDER">
      <Component Id="DesigncraftApp" Guid="DE018EF3-EE87-4E36-9F76-0B7B060A195E">
        <File Id="DesigncraftExe" Source="$(var.BinDir)\designcraft.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="MIXEL Design"
              Description="MIXEL Design page layout and publishing" WorkingDirectory="INSTALLFOLDER" Advertise="yes"
              Icon="DesigncraftIcon.ico" IconIndex="0" />
        </File>

        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\designcraft.exe" Value="[#DesigncraftExe]" Type="string" />
      </Component>

      <Component Id="DesigncraftCli">
        <File Id="DesigncraftCliExe" Source="$(var.BinDir)\designcraft-cli.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>

  <Fragment>
    <ComponentGroup Id="LegalNoticesDesign">
      <Component Id="LegalComponentcc7783b38182cc450eb3" Directory="LegalDira77854315fcafe53db14">
        <File Id="LegalFilecc7783b38182cc450eb3" Source="$(var.BinDir)\Licenses\NOTICE" KeyPath="yes" />
      </Component>
      <Component Id="LegalComponentc77e847ce0024be9d3c3" Directory="LegalDir586c79a12a8241f97438">
        <File Id="LegalFilec77e847ce0024be9d3c3" Source="$(var.BinDir)\Licenses\epaint_default_fonts-0.36.2\Hack-Regular.txt" KeyPath="yes" />
      </Component>
      <Component Id="LegalComponent902cc6dc0ec6fb28b005" Directory="LegalDir586c79a12a8241f97438">
        <File Id="LegalFile902cc6dc0ec6fb28b005" Source="$(var.BinDir)\Licenses\epaint_default_fonts-0.36.2\OFL.txt" KeyPath="yes" />
      </Component>
      <Component Id="LegalComponent46927afaefcef6927926" Directory="LegalDir586c79a12a8241f97438">
        <File Id="LegalFile46927afaefcef6927926" Source="$(var.BinDir)\Licenses\epaint_default_fonts-0.36.2\UFL.txt" KeyPath="yes" />
      </Component>
      <Component Id="LegalComponent5d0aa4b0e87032dccc73" Directory="LegalDir586c79a12a8241f97438">
        <File Id="LegalFile5d0aa4b0e87032dccc73" Source="$(var.BinDir)\Licenses\epaint_default_fonts-0.36.2\emoji-icon-font-mit-license.txt" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
